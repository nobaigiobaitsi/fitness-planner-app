{
  "expo": {
    "name": "FitPlanner",
    "slug": "fitplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/FitPlanner-icon.png",
    "scheme": "fitplanner",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.fitplanner.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.fitplanner.app",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F17",
        "foregroundImage": "./assets/images/android-FitPlanner-foreground.png",
        "backgroundImage": "./assets/images/android-FitPlanner-background.png",
        "monochromeImage": "./assets/images/android-FitPlanner-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/FitPlanner-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F17",
          "image": "./assets/images/android-FitPlanner-foreground.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
