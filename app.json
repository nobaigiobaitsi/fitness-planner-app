{
  "expo": {
    "name": "FitPlanner",
    "slug": "fitplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/FitPlanner-icon.png",
    "scheme": "fitplanner",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.stavrosangelopoulos.fitplanner",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stavrosangelopoulos.fitplanner",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F17",
        "foregroundImage": "./assets/images/android-FitPlanner-foreground.png",
        "backgroundImage": "./assets/images/android-FitPlanner-background.png",
        "monochromeImage": "./assets/images/android-FitPlanner-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/FitPlanner-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1F17",
          "image": "./assets/images/android-FitPlanner-foreground.png",
          "imageWidth": 76
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58c2b598-c856-4487-a020-9560b38e900c"
      }
    },
    "owner": "nobaigiobaitsi"
  }
}
